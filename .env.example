# Copy to .env. Every value below has a working default in docker-compose.yml,
# so `docker compose up` runs with no edits. Change these only to point at
# something real.

# Postgres
POSTGRES_USER=ridgeline
POSTGRES_PASSWORD=ridgeline
POSTGRES_DB=ridgeline
DATABASE_URL=postgres://ridgeline:ridgeline@db:5432/ridgeline

# Model service
MODEL_SERVICE_URL=http://model:8000
# Path to a trained checkpoint. If the file is missing the service falls back to
# the frame-differencing scorer and says so on /health.
MODEL_CHECKPOINT=/app/weights/smokenet.pt

# Which scorer to run: auto, heuristic, or trained.
#
# Shipped as heuristic on purpose. The checkpoint produced by the short training
# run in the README loses on the bundled sequences: it finds none of the five
# fires at a checkable location, misses two outright, raises a false alarm on
# clear sky, and returns no bounding box, so an operator would get an alert with
# nowhere to look. The heuristic finds four of five with the box on the plume and
# raises no false alarms. Both tables are in the README. Train on more of FIgLib
# with a GPU, re-run validate_replay.py for both scorers, and switch this to auto
# or trained once the trained one actually wins.
SCORER=heuristic

# Web app
WEB_BASE_URL=http://web:3000
NEXT_PUBLIC_APP_NAME=Ridgeline

# Temporal-consistency rule. A detection is confirmed only after
# CONSECUTIVE_FRAMES frames in a row each score at or above CONFIDENCE_THRESHOLD.
CONFIDENCE_THRESHOLD=0.6
CONSECUTIVE_FRAMES=3

# Alerting. Leave blank to have test alerts recorded in the database and shown
# in the UI without any outbound network call.
SLACK_WEBHOOK_URL=

# Live camera polling. Off by default. HPWREN imagery is CC BY-NC-ND 4.0:
# non-commercial, no derivatives, attribution required. Read
# https://www.hpwren.ucsd.edu/cc.html before turning this on.
ENABLE_LIVE_SOURCES=false
LIVE_POLL_INTERVAL_SECONDS=60

# Host ports. Change these if something else on your machine already uses them.
# Only the host side moves; the services talk to each other on the compose
# network and are unaffected.
WEB_PORT=3100
MODEL_PORT=8100
DB_PORT=5532
